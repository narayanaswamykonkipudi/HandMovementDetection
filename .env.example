# Copy this file to `.env` and edit as needed. All variables are optional.
# Command-line flags in `python app.py` override these values.

# Server ---------------------------------------------------------------------
ASL_HOST=127.0.0.1
ASL_PORT=8501
ASL_LOG_LEVEL=INFO
# Localhost-only by default. Do not expose this demo to a network.
ASL_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Camera ---------------------------------------------------------------------
ASL_CAMERA_INDEX=0
ASL_FRAME_WIDTH=960
ASL_FRAME_HEIGHT=540
ASL_MIRROR=true
ASL_AUTOSTART_CAMERA=false
ASL_CAMERA_SCAN_MAX=5

# Model ----------------------------------------------------------------------
# Omit to use models/classifier.joblib. Set ASL_DEMO=true for the synthetic model.
# ASL_MODEL_PATH=models/classifier.joblib
ASL_DEMO=false
ASL_RELOAD_ON_STARTUP=true

# Speech ---------------------------------------------------------------------
ASL_SPEECH_ENABLED=true
ASL_SPEECH_RATE=170
ASL_SPEECH_VOLUME=1.0
# ASL_SPEECH_VOICE=Zira

# Optional LLM post-processing (Phase 3). Disabled by default. Text only:
# never video, landmarks, camera frames, or server files are sent.
ASL_LLM_ENABLED=false
# ASL_LLM_API_KEY=
ASL_LLM_MODEL=gpt-4o-mini
ASL_LLM_BASE_URL=https://api.openai.com/v1
ASL_LLM_TIMEOUT_SECONDS=12
